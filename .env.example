# Copy this file to .env and fill in your API keys
# .env is gitignored — never commit real keys

# ── Claude API (required) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Email delivery (required) ─────────────────────────────────────────────────
# Gmail: enable 2FA, then generate App Password at myaccount.google.com/apppasswords
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_TO=recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Data sources (optional — free fallbacks exist) ────────────────────────────
# Financial Modeling Prep — paid fallback for transcripts if Motley Fool goes behind paywall
FMP_API_KEY=your_fmp_key_here

# Finnhub — free tier covers news and earnings calendar (no transcript access needed)
FINNHUB_API_KEY=your_finnhub_key_here
